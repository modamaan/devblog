{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "devblog",
  "compatibility_date": "2026-08-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".worker-next/index.mjs",
  "assets": {
    "directory": ".worker-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
